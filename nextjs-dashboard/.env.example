# Runtime configuration. Never commit actual credentials.
DATABASE_URL="postgresql://portfolio:local_password@127.0.0.1:5432/portfolio?schema=public"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="owner@example.com"
# Generate with pnpm admin:password; plaintext passwords are not accepted.
ADMIN_PASSWORD_HASH=""
# Local development / tests: disabled. Production: emailjs.
EMAIL_DELIVERY="disabled"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
# true prevents contact, chat and project writes during migration.
READ_ONLY_MODE="false"
